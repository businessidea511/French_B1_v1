# ── App (assets/.env, local dev only) ───────────────────────────────────────
# Only PUBLIC values belong here: this file is bundled into the web build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Server secrets (Vercel → Project Settings → Environment Variables) ──────
# Used only by the functions in /api. Never put these in assets/.env.
# DEEPSEEK_API_KEY=...
# HF_TOKEN=...
# ADMIN_PASSWORD=...
# SUPABASE_URL=...                 (same as above)
# SUPABASE_SERVICE_ROLE_KEY=...    (Supabase → Settings → API keys → secret / service_role)
# ALLOWED_ORIGINS=                 (optional, comma-separated extra origins for CORS)

# Local dev: flutter run -d chrome --dart-define=API_BASE=https://<your-app>.vercel.app
